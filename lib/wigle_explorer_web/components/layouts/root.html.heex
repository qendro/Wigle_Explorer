<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="WiGLE Explorer" phx-no-format>{assigns[:page_title]}</.live_title>
    <meta
      name="description"
      content="Explore Wi-Fi, Bluetooth, and cellular observations in a map area with WiGLE."
    />
    <link rel="icon" type="image/svg+xml" href={~p"/images/wifi.svg"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
